{
  "name": "shazzoo/assistant-plugin",
  "description": "AI assistant for Content Studio: visitors ask questions and get answers from the site's own content, powered by Claude.",
  "type": "content-studio-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "anthropic-ai/sdk": "^0.51.0",
    "filament/filament": "^5.0",
    "livewire/livewire": "^4.0",
    "shazzoo/content-studio-core": "^1.5"
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "repositories": [
    {
      "type": "git",
      "url": "git@github.com:Shazzoo/content-studio-core.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "Shazzoo\\Assistant\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shazzoo\\Assistant\\Tests\\": "tests/"
    }
  },
  "extra": {
    "content-studio": {
      "key": "shazzoo/assistant",
      "slug": "assistant",
      "name": "Assistant",
      "description": "An AI assistant that answers visitors' questions from the site's own content.",
      "provider": "Shazzoo\\Assistant\\AssistantServiceProvider"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
